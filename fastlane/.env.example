# App Store Connect API Key
# App Store Connect → 사용자 및 액세스 → 통합 → API 키에서 발급
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_FILEPATH=fastlane/credentials/AuthKey_XXXXXXXXXX.p8

# Apple ID (선택 — Appfile에서 필요 시)
APPLE_ID=your@email.com
ITC_TEAM_ID=
APPLE_TEAM_ID=

# Google Play Service Account JSON
# Play Console → 설정 → API 액세스 → 서비스 계정에서 발급
GOOGLE_PLAY_JSON_KEY=fastlane/credentials/google_play_service_account.json
